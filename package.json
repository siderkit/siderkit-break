{
  "name": "siderkit-break",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "A tiny cross-platform break reminder.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0 --report-unused-disable-directives",
    "check:types": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:unit": "pnpm test:unit",
    "test:unit": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations && vitest run --coverage",
    "check:css": "node scripts/check-css.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:interaction": "node scripts/check-interaction.mjs",
    "check:ui-patterns": "node scripts/check-ui-patterns.mjs",
    "check:structure": "node scripts/check-structure.mjs",
    "check:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "check:duplicates": "jscpd src src-tauri/src",
    "check:todo": "node scripts/check-todo.mjs",
    "check:file-size": "node scripts/check-file-size.mjs",
    "check:download-urls": "node scripts/check-download-urls.mjs",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml",
    "check:web": "pnpm check:css && pnpm check:tokens && pnpm check:interaction && pnpm check:ui-patterns && pnpm check:structure && pnpm lint && pnpm test:unit && pnpm check:types && pnpm check:boundaries && pnpm check:duplicates && pnpm check:todo && pnpm check:file-size && pnpm check:download-urls",
    "check:clean": "pnpm check:web && pnpm check:rust",
    "check": "pnpm format:check && pnpm check:clean",
    "check:i18n": "inlang check --project ./project.inlang"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "svelte": "^5.58.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inlang/cli": "^3.4.0",
    "@inlang/paraglide-js": "^3.2.2",
    "@inlang/plugin-m-function-matcher": "^2.4.3",
    "@inlang/plugin-message-format": "^4.6.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.6",
    "@vitest/coverage-v8": "^5.1.1",
    "dependency-cruiser": "^18.8.0",
    "eslint": "^10.15.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "jscpd": "^5.4.3",
    "lint-staged": "^17.3.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
